# Öffentliche Domains ohne Protokoll
SITE_DOMAIN=findelio.ch
CMS_DOMAIN=cms.findelio.ch
ACME_EMAIL=info@findelio.ch

# PostgreSQL – vor dem ersten Start mit zufälligen Werten ersetzen
POSTGRES_DB=findelio
POSTGRES_USER=findelio
POSTGRES_PASSWORD=change-me-long-random-database-password

# Directus
DIRECTUS_SECRET=change-me-at-least-64-random-characters
DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=change-me-long-random-admin-password
DIRECTUS_TOKEN=change-me-dedicated-directus-service-token
DIRECTUS_EMAIL_SMTP_USER=change-me
DIRECTUS_EMAIL_SMTP_PASSWORD=change-me
ADMIN_NOTIFICATION_EMAIL=info@findelio.ch

# Zahlungsabwicklung – ausschliesslich Live-Werte verwenden
STRIPE_SECRET_KEY=sk_live_change-me
STRIPE_WEBHOOK_SECRET=whsec_change-me
STRIPE_PRICE_PREMIUM_MONTHLY=price_change-me
STRIPE_PRICE_PREMIUM_YEARLY=price_change-me

# Sitzungen und bestehender Datenbankstand
AUTH_REFRESH_COOKIE_TTL_SECONDS=604800
MIGRATION_BASELINE=20260804_deletion_requests.sql
MIGRATION_BASELINE_CHECK_TABLE=deletion_requests
