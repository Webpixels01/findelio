{
  "name": "findelio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:webpack": "next dev --webpack",
    "build": "npm run check:email-logo && next build",
    "check:email-logo": "node scripts/check-email-logo.mjs",
    "start": "next start",
    "lint": "eslint",
    "test:i18n": "node --test tests/vietnamese-locale.test.mjs",
    "test:listing-pagination": "node --test tests/listing-pagination.test.mjs",
    "test:referral-dates": "node --experimental-strip-types --test lib/referral-dates.test.ts",
    "test:referral-registration": "node --experimental-strip-types --test lib/referral-registration.test.ts lib/register-search-params.test.ts && node --test infra/directus/extensions/directus-extension-findelio-referrals/src/referral-utils.test.mjs",
    "typecheck:referral-dates": "tsc --noEmit -p tsconfig.referral-dates.test.json",
    "build:referral-extension": "node scripts/build-referral-extension.mjs",
    "test:referral-approval": "node --test infra/directus/extensions/directus-extension-findelio-referrals/src/referral-approval.test.mjs",
    "test:referral-admin": "node --test infra/directus/extensions/directus-extension-findelio-referrals/src/referral-admin.test.mjs tests/referral-admin-render.mjs",
    "test:security": "node --test tests/security.test.mjs tests/braces-security.test.mjs tests/deployment-security.test.mjs tests/deploy-workflow.test.mjs tests/two-factor.test.mjs",
    "build:security-extensions": "node scripts/build-security-extensions.mjs",
    "test:security-repairs": "node --test tests/login-transport-budget.test.mjs tests/stripe-webhook-ordering.test.mjs tests/premium-admin-access.test.mjs infra/directus/extensions/directus-extension-findelio-referrals/src/referral-approval.test.mjs",
    "test:security-postgres": "node --test --test-concurrency=1 tests/team-concurrency.integration.mjs tests/deletion-concurrency.integration.mjs tests/notification-delivery.postgres.mjs tests/stripe-state.postgres.mjs tests/premium-permissions.postgres.mjs tests/referral-workflow.postgres.mjs",
    "test:regression": "node --test --test-concurrency=1 tests/*.test.mjs tests/referral-admin-render.mjs infra/directus/extensions/directus-extension-findelio-referrals/src/*.test.mjs && node --experimental-strip-types --test lib/referral-dates.test.ts lib/referral-registration.test.ts lib/register-search-params.test.ts",
    "test:security-native": "node tests/security-repairs-directus.integration.mjs",
    "test:production-smoke": "node tests/security-repairs-production.mjs"
  },
  "dependencies": {
    "@fontsource-variable/roboto-condensed": "^5.3.0",
    "next": "^16.4.2",
    "next-intl": "4.13.2",
    "qrcode.react": "4.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.5",
    "stripe": "^22.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "braces": "file:vendor/braces",
    "eslint": "^9",
    "eslint-config-next": "^16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "braces": "$braces"
  }
}
